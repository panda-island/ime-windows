#include <windows.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,@LLAVON_VERSION_REVISION@
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE @LLAVON_VERSION_FILE_TYPE@
 FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Llavon IME\0"
            VALUE "FileDescription", "@LLAVON_VERSION_DESCRIPTION@\0"
            VALUE "FileVersion", "@LLAVON_IME_VERSION@.@LLAVON_IME_BUILD_NUMBER@\0"
            VALUE "ProductName", "Llavon IME\0"
            VALUE "ProductVersion", "@LLAVON_IME_VERSION@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
